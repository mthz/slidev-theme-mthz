{
  "name": "slidev-theme-mthz",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "Slidev theme for lecture decks and academic talks.",
  "license": "MIT",
  "author": "Matthias Schörghuber <schoerki@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mthz/slidev-theme-mthz.git"
  },
  "homepage": "https://github.com/mthz/slidev-theme-mthz#readme",
  "engines": {
    "node": ">=22.12.0",
    "slidev": ">=53.0.0"
  },
  "packageManager": "pnpm@10.15.1",
  "keywords": [
    "slidev-theme",
    "slidev",
    "academic",
    "lecture"
  ],
  "files": [
    "assets",
    "components",
    "layouts",
    "setup",
    "styles",
    "skills",
    "layout-helper.ts",
    "slide-bottom.vue",
    "vite.config.ts",
    "example.md"
  ],
  "slidev": {
    "colorSchema": "light",
    "defaults": {
      "fonts": {
        "sans": "Avenir Next,Nunito Sans Variable",
        "mono": "Fira Code Variable",
        "local": "Avenir Next,Nunito Sans Variable,Fira Code Variable",
        "provider": "none"
      }
    }
  },
  "scripts": {
    "dev": "slidev example.md --open",
    "build": "slidev build example.md",
    "export": "slidev export example.md",
    "screenshot": "slidev export example.md --format png --output shots"
  },
  "dependencies": {
    "@fontsource-variable/fira-code": "^5.3.0",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@iconify-json/mdi": "^1.2.0"
  },
  "devDependencies": {
    "@slidev/cli": "^53.0.0",
    "@slidev/types": "^53.0.0",
    "playwright-chromium": "^1.64.0"
  }
}
